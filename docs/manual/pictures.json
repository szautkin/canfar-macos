    {
      "name": "pending",
      "chapter": "12-ai-assistant",
      "steps": [
        [
          "add_guide_tool",
          {
            "name": "observing_log_conventions",
            "description": {
              "en": "How I name and annotate observing logs.",
              "fr": "Comment je nomme et annote mes journaux d’observation."
            },
            "body": {
              "en": "Name each log by date and target; note seeing and transparency.",
              "fr": "Nommez chaque journal par date et cible ; notez le seeing et la transparence."
            },
            "why": {
              "en": "An example for the manual's picture of Pending; it is withdrawn right after.",
              "fr": "Un exemple pour l’image de En attente dans le manuel ; il est retiré aussitôt après."
            }
          }
        ],
        [
          "open_ui",
          {
            "target": "=Pending Changes"
          }
        ]
      ],
      "after": [
        [
          "close_ui",
          {
            "target": "=Pending Changes"
          }
        ]
      ]
    },
    {
      "name": "hints",
      "chapter": "12-ai-assistant",
      "steps": [
        [
          "navigate_to",
          {
            "mode": "landing"
          }
        ],
        [
          "show_ui_hints",
          {
            "mode": "replace",
            "numbered": true,
            "dim": true,
            "untilClosed": true,
            "hints": [
              {
                "target": "home.search",
                "title": {
                  "en": "Find observations",
                  "fr": "Trouver des observations"
                },
                "text": {
                  "en": "Start here: search the CADC archive by target or position.",
                  "fr": "Commencez ici : cherchez dans l’archive du CADC par cible ou par position."
                }
              },
              {
                "target": "home.research",
                "title": {
                  "en": "Keep them",
                  "fr": "Les garder"
                },
                "text": {
                  "en": "What you keep is in Research, with your notes.",
                  "fr": "Ce que vous gardez est dans Recherche, avec vos notes."
                }
              }
            ]
          }
        ]
      ]
    },
