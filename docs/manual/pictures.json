    {
      "name": "hints",
      "chapter": "12-ai-assistant",
      "steps": [
        [
          "navigate_to",
          {
            "mode": "landing"
          }
        ],
        [
          "show_ui_hints",
          {
            "mode": "replace",
            "numbered": true,
            "dim": true,
            "untilClosed": true,
            "hints": [
              {
                "target": "home.search",
                "title": {
                  "en": "Find observations",
                  "fr": "Trouver des observations"
                },
                "text": {
                  "en": "Start here: search the CADC archive by target or position.",
                  "fr": "Commencez ici : cherchez dans l’archive du CADC par cible ou par position."
                }
              },
              {
                "target": "home.research",
                "title": {
                  "en": "Keep them",
                  "fr": "Les garder"
                },
                "text": {
                  "en": "What you keep is in Research, with your notes.",
                  "fr": "Ce que vous gardez est dans Recherche, avec vos notes."
                }
              }
            ]
          }
        ]
      ]
