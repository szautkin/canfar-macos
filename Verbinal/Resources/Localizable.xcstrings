    "Verbinal is sandboxed, so your AI client — not Verbinal — launches the bundled helper. This confirms the MCP server is reachable; the final proof is restarting your client and seeing the Verbinal tools appear." : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinal est en bac à sable ; c'est donc votre client IA — et non Verbinal — qui lance l'assistant intégré. Ceci confirme que le serveur MCP est accessible ; la preuve finale est de redémarrer votre client et de voir apparaître les outils Verbinal."
          }
        }
      }
    },
    "Verbinal Login" : {
      "extractionState" : "stale",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion à Verbinal"
          }
        }
      }
    },
    "Verbinal may not open the file where it is — open it once from Research to give it access again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinal ne peut pas ouvrir le fichier là où il se trouve — ouvrez-le une fois depuis Recherche pour lui en redonner l'accès."
          }
        }
      }
    },
    "Verbinal needs to restart to apply the new language." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinal doit redémarrer pour appliquer la nouvelle langue."
          }
        }
      }
    },
    "Verbinal needs your permission to re-open %@. Click Open to confirm." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinal a besoin de votre permission pour rouvrir %@. Cliquez sur Ouvrir pour confirmer."
