    },
    "That region is larger than any cutout can be." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette région est plus grande qu'aucune découpe ne peut l'être."
          }
        }
      }
    },
    "That region is outside this file's footprint." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette région est hors de l'empreinte de ce fichier."
          }
        }
      }
    },
    "That time range is outside this file's." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette période est hors de celle du fichier."
          }
